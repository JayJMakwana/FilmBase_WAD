@model IEnumerable<FilmBase.Models.DTOs.TmdbMovieDto>

@if (Model != null && Model.Any())
{
    foreach (var movie in Model)
    {
        var displayTitle = !string.IsNullOrEmpty(movie.Title) ? movie.Title : movie.Name;
        var rawDate = !string.IsNullOrEmpty(movie.ReleaseDate) ? movie.ReleaseDate : movie.FirstAirDate;
        
        var rating = movie.VoteAverage.HasValue && movie.VoteAverage > 0 ? movie.VoteAverage.Value.ToString("0.1") : null;
        var year = !string.IsNullOrEmpty(rawDate) && rawDate.Length >= 4 ? rawDate.Substring(0, 4) : "";

        <div class="col">
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="text-decoration-none">
                <div class="movie-card">
                    @if (rating != null)
                    {
                        <div class="movie-rating-badge">
                            <span>⭐</span>
                            <span>@rating</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(movie.PosterPath))
                    {
                        <img src="https://wsrv.nl/?url=image.tmdb.org/t/p/w500@(movie.PosterPath)" alt="@displayTitle" loading="lazy">
                    }
                    else
                    {
                        <img src="/images/movie_poster_fallback.jpg" alt="@displayTitle" loading="lazy">
                    }

                    <div class="movie-card-overlay">
                        <h4 class="movie-card-title">@displayTitle</h4>
                        <div class="movie-card-meta">
                            @if (!string.IsNullOrEmpty(year))
                            {
                                <span>@year</span>
                            }
                            @if (!string.IsNullOrEmpty(year) && rating != null)
                            {
                                <span>·</span>
                            }
                            @if (rating != null)
                            {
                                <span>Score @rating</span>
                            }
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
}