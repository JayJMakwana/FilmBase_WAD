@model FilmBase.Models.ViewModels.MovieViewModel

<div class="card h-100 shadow-sm">
    <img src="@Model.PosterUrl" class="card-img-top" alt="@Model.Title Poster"
         onerror="this.src='/images/placeholder.jpg'">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-truncate" title="@Model.Title">@Model.Title</h5>

        <div class="mb-2">
            @foreach (var genre in Model.Genres.Take(3))
            {
                <span class="badge bg-secondary me-1">@genre</span>
            }
        </div>

        <a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline-primary mt-auto w-100">
            View Details
        </a>
    </div>
</div>