@model IEnumerable<FilmBase.Models.DTOs.TmdbMovieDto>

@{
    ViewData["Title"] = "Discover";
    var currentQuery = ViewData["CurrentQuery"] as string;
    var filterName = ViewData["FilterName"] as string;

    string displayTitle = !string.IsNullOrEmpty(currentQuery) ? $"Search Results for '{currentQuery}'" :
                          !string.IsNullOrEmpty(filterName) ? $"Results for {filterName}" : "";
}

<div class="py-4">
    <!-- Search Bar -->
    <form method="get" asp-controller="Movies" asp-action="Discover" class="mb-10 max-w-3xl mx-auto">
        <div class="relative flex items-center">
            <div class="absolute left-4 pointer-events-none text-slate-400">
                <span>🔍</span>
            </div>
            <input type="text"
                   name="query"
                   value="@currentQuery"
                   placeholder="Search movie titles, actors, or genres..."
                   class="w-full pl-12 pr-28 py-3.5 bg-[#101422] text-white text-sm sm:text-base border border-white/10 rounded-2xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 shadow-lg placeholder:text-slate-500 transition-all"
                   autofocus />
            <button type="submit"
                    class="absolute right-2.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl shadow-md transition-all cursor-pointer">
                Search
            </button>
        </div>
    </form>

    @if (string.IsNullOrEmpty(currentQuery) && string.IsNullOrEmpty(filterName))
    {
        <!-- Discover Categories -->
        <div class="max-w-4xl mx-auto space-y-8">
            <!-- Language -->
            <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="text-indigo-400">🌐</span>
                    <h3 class="text-sm font-semibold text-slate-200 uppercase tracking-wider">Browse by Language</h3>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <a asp-action="Discover" asp-route-filterType="language" asp-route-filterValue="en" asp-route-filterName="English" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">English</a>
                    <a asp-action="Discover" asp-route-filterType="language" asp-route-filterValue="hi" asp-route-filterName="Hindi" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Hindi</a>
                    <a asp-action="Discover" asp-route-filterType="language" asp-route-filterValue="es" asp-route-filterName="Spanish" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Spanish</a>
                    <a asp-action="Discover" asp-route-filterType="language" asp-route-filterValue="ja" asp-route-filterName="Japanese" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Japanese</a>
                    <a asp-action="Discover" asp-route-filterType="language" asp-route-filterValue="ko" asp-route-filterName="Korean" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Korean</a>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-indigo-400 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all cursor-pointer" data-bs-toggle="modal" data-bs-target="#customFilterModal" data-filter-type="language" data-modal-title="More Languages">+ More Languages</button>
                </div>
            </div>

            <!-- Year -->
            <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="text-indigo-400">📅</span>
                    <h3 class="text-sm font-semibold text-slate-200 uppercase tracking-wider">Browse by Release Year</h3>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <a asp-action="Discover" asp-route-filterType="year" asp-route-filterValue="2024" asp-route-filterName="2024" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">2024</a>
                    <a asp-action="Discover" asp-route-filterType="year" asp-route-filterValue="2023" asp-route-filterName="2023" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">2023</a>
                    <a asp-action="Discover" asp-route-filterType="year" asp-route-filterValue="2022" asp-route-filterName="2022" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">2022</a>
                    <a asp-action="Discover" asp-route-filterType="year" asp-route-filterValue="2021" asp-route-filterName="2021" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">2021</a>
                    <a asp-action="Discover" asp-route-filterType="year" asp-route-filterValue="2020" asp-route-filterName="2020" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">2020</a>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-indigo-400 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all cursor-pointer" data-bs-toggle="modal" data-bs-target="#customFilterModal" data-filter-type="year" data-modal-title="Specific Year">+ Specific Year</button>
                </div>
            </div>

            <!-- Genre -->
            <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="text-indigo-400">✨</span>
                    <h3 class="text-sm font-semibold text-slate-200 uppercase tracking-wider">Browse by Genre</h3>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <a asp-action="Discover" asp-route-filterType="genre" asp-route-filterValue="28" asp-route-filterName="Action" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Action</a>
                    <a asp-action="Discover" asp-route-filterType="genre" asp-route-filterValue="35" asp-route-filterName="Comedy" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Comedy</a>
                    <a asp-action="Discover" asp-route-filterType="genre" asp-route-filterValue="18" asp-route-filterName="Drama" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Drama</a>
                    <a asp-action="Discover" asp-route-filterType="genre" asp-route-filterValue="27" asp-route-filterName="Horror" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Horror</a>
                    <a asp-action="Discover" asp-route-filterType="genre" asp-route-filterValue="878" asp-route-filterName="Sci-Fi" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] hover:text-white border border-white/[0.08] transition-all text-decoration-none">Sci-Fi</a>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-indigo-400 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all cursor-pointer" data-bs-toggle="modal" data-bs-target="#customFilterModal" data-filter-type="genre" data-modal-title="More Genres">+ More Genres</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Results Section -->
        <div>
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight font-display">
                    @displayTitle
                </h2>
                <a asp-action="Discover" class="px-3.5 py-1.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] text-xs font-medium text-slate-300 hover:text-white border border-white/10 flex items-center gap-1.5 transition-colors text-decoration-none">
                    <span>✕</span>
                    <span>Clear Filter</span>
                </a>
            </div>

            <!-- Results Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6 mb-8" id="movie-grid">
                @if (Model != null && Model.Any())
                {
                    <partial name="_MovieCards" model="Model" />
                }
                else
                {
                    <div class="col-span-full py-24 text-center" id="no-results-msg">
                        <p class="text-slate-400 text-base">No movies found. Try another search or filter.</p>
                    </div>
                }
            </div>

            <!-- Infinite Scroll Trigger -->
            @if (Model != null && Model.Any())
            {
                <div id="scroll-trigger" class="py-12 flex justify-center">
                    <div class="hidden items-center gap-2.5 text-indigo-400 text-sm font-medium" id="loading-spinner">
                        <span class="animate-spin text-lg">⏳</span>
                        <span>Searching movies...</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Custom Filter Modal -->
<div class="modal fade" id="customFilterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #0e121d; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; overflow: hidden; color: #fff;">
            <form method="get" asp-controller="Movies" asp-action="Discover" onsubmit="setModalValues()">
                <div class="modal-header" style="background-color: #121726; border-bottom: 1px solid rgba(255,255,255,0.08); padding: 1rem 1.5rem;">
                    <h5 class="modal-title font-bold text-white text-base" id="customFilterModalLabel">Filter Collection</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-6 space-y-4">
                    <input type="hidden" name="filterType" id="modalFilterType" />
                    <input type="hidden" name="filterName" id="modalFilterName" />
                    <input type="hidden" name="filterValue" id="modalFilterValue" />

                    <!-- Language Selection -->
                    <div id="languageInputGroup" class="hidden space-y-2">
                        <label class="block text-xs font-medium text-slate-400">Select Language</label>
                        <select class="w-full px-3.5 py-2.5 text-sm bg-black/50 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" id="languageSelect">
                            <option value="en">English</option>
                            <option value="hi">Hindi</option>
                            <option value="gu">Gujarati</option>
                            <option value="ta">Tamil</option>
                            <option value="te">Telugu</option>
                            <option value="ml">Malayalam</option>
                            <option value="mr">Marathi</option>
                            <option value="bn">Bengali</option>
                            <option value="pa">Punjabi</option>
                            <option value="es">Spanish</option>
                            <option value="fr">French</option>
                            <option value="ja">Japanese</option>
                            <option value="ko">Korean</option>
                            <option value="zh">Mandarin / Chinese</option>
                            <option value="de">German</option>
                            <option value="it">Italian</option>
                            <option value="ru">Russian</option>
                        </select>
                    </div>

                    <!-- Year Selection -->
                    <div id="yearInputGroup" class="hidden space-y-2">
                        <label class="block text-xs font-medium text-slate-400">Select Release Year</label>
                        <select class="w-full px-3.5 py-2.5 text-sm bg-black/50 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" id="yearSelect">
                            @for (int y = 2026; y >= 1990; y--)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>

                    <!-- Genre Selection -->
                    <div id="genreInputGroup" class="hidden space-y-2">
                        <label class="block text-xs font-medium text-slate-400">Select Genre</label>
                        <select class="w-full px-3.5 py-2.5 text-sm bg-black/50 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" id="genreSelect">
                            <option value="28">Action</option>
                            <option value="12">Adventure</option>
                            <option value="16">Animation</option>
                            <option value="35">Comedy</option>
                            <option value="80">Crime</option>
                            <option value="99">Documentary</option>
                            <option value="18">Drama</option>
                            <option value="10751">Family</option>
                            <option value="14">Fantasy</option>
                            <option value="36">History</option>
                            <option value="27">Horror</option>
                            <option value="10402">Music</option>
                            <option value="9648">Mystery</option>
                            <option value="10749">Romance</option>
                            <option value="878">Sci-Fi</option>
                            <option value="53">Thriller</option>
                            <option value="10752">War</option>
                            <option value="37">Western</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer p-4 border-t border-white/[0.08] flex justify-end gap-3">
                    <button type="button" class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="px-5 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg shadow-lg shadow-indigo-600/30">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;

        const currentQuery = '@Html.Raw(currentQuery ?? "")';
        const filterType = '@Html.Raw(ViewData["FilterType"] ?? "")';
        const filterValue = '@Html.Raw(ViewData["FilterValue"] ?? "")';
        const filterName = '@Html.Raw(ViewData["FilterName"] ?? "")';

        const spinner = document.getElementById("loading-spinner");
        const grid = document.getElementById("movie-grid");
        const trigger = document.getElementById("scroll-trigger");

        // Modal Configuration Logic
        const customFilterModal = document.getElementById('customFilterModal');
        if (customFilterModal) {
            customFilterModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const modalFilterType = button.getAttribute('data-filter-type');
                const modalTitle = button.getAttribute('data-modal-title');
                
                document.getElementById('customFilterModalLabel').textContent = modalTitle;
                document.getElementById('modalFilterType').value = modalFilterType;

                const langGroup = document.getElementById('languageInputGroup');
                const yearGroup = document.getElementById('yearInputGroup');
                const genreGroup = document.getElementById('genreInputGroup');

                langGroup.classList.add('hidden');
                yearGroup.classList.add('hidden');
                genreGroup.classList.add('hidden');

                if (modalFilterType === 'language') {
                    langGroup.classList.remove('hidden');
                } else if (modalFilterType === 'year') {
                    yearGroup.classList.remove('hidden');
                    document.getElementById('yearSelect').value = '2024';
                } else if (modalFilterType === 'genre') {
                    genreGroup.classList.remove('hidden');
                }
            });
        }

        // Infinite Scroll
        if (!currentQuery && !filterType) return;

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !isLoading && hasMore) {
                loadMoreMovies();
            }
        }, { rootMargin: "300px" });

        if (trigger) observer.observe(trigger);

        async function loadMoreMovies() {
            isLoading = true;
            if (spinner) spinner.classList.remove("hidden");
            currentPage++;

            const params = new URLSearchParams({ ajax: 'true', page: currentPage });
            if (currentQuery) params.append('query', currentQuery);
            if (filterType) params.append('filterType', filterType);
            if (filterValue) params.append('filterValue', filterValue);
            if (filterName) params.append('filterName', filterName);

            try {
                const response = await fetch(`/Movies/Discover?${params.toString()}`);
                const html = await response.text();

                if (html.trim().length === 0) {
                    hasMore = false;
                    if (trigger) trigger.style.display = 'none';
                } else {
                    grid.insertAdjacentHTML("beforeend", html);
                }
            } catch (error) {
                console.error("Failed to fetch more movies");
            } finally {
                isLoading = false;
                if (spinner) spinner.classList.add("hidden");
            }
        }
    });

    function setModalValues() {
        const type = document.getElementById('modalFilterType').value;
        const nameInput = document.getElementById('modalFilterName');
        const valInput = document.getElementById('modalFilterValue');

        if (type === 'language') {
            const sel = document.getElementById('languageSelect');
            valInput.value = sel.value;
            nameInput.value = sel.options[sel.selectedIndex].text;
        } else if (type === 'year') {
            const sel = document.getElementById('yearSelect');
            valInput.value = sel.value;
            nameInput.value = sel.value;
        } else if (type === 'genre') {
            const sel = document.getElementById('genreSelect');
            valInput.value = sel.value;
            nameInput.value = sel.options[sel.selectedIndex].text;
        }
    }
</script>