@model IEnumerable<FilmBase.Models.DTOs.TmdbMovieDto>

@{
    ViewData["Title"] = ViewData["CategoryTitle"];
    var categorySlug = ViewData["CategorySlug"] as string;
}

<div class="container mt-4 text-white">
    
    <div class="d-flex align-items-center border-bottom border-secondary pb-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-light btn-sm me-3">← Back</a>
        <h4 class="fw-bold mb-0">@ViewData["CategoryTitle"]</h4>
    </div>

    <!-- Movie Grid -->
    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4 mb-4" id="movie-grid">
        @if (Model != null && Model.Any())
        {
            <partial name="_MovieCards" model="Model" />
        }
        else
        {
            <div class="col-12" id="no-results-msg">
                <p class="text-muted text-center mt-5 fs-5">No movies found for this collection.</p>
            </div>
        }
    </div>

    <!-- Invisible trigger for infinite scroll -->
    @if (Model != null && Model.Any())
    {
        <div id="scroll-trigger" class="text-center py-4 mb-5">
            <div class="spinner-border text-primary d-none" id="loading-spinner" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;

        const category = '@Html.Raw(categorySlug ?? "")';
        const spinner = document.getElementById("loading-spinner");
        const grid = document.getElementById("movie-grid");
        const trigger = document.getElementById("scroll-trigger");

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !isLoading && hasMore) {
                loadMoreMovies();
            }
        }, { rootMargin: "200px" });

        if (trigger) observer.observe(trigger);

        async function loadMoreMovies() {
            isLoading = true;
            spinner.classList.remove("d-none");
            currentPage++;

            const params = new URLSearchParams({ category: category, page: currentPage, ajax: 'true' });

            try {
                const response = await fetch(`/Movies/Browse?${params.toString()}`);
                const html = await response.text();

                if (html.trim().length === 0) {
                    hasMore = false;
                    if (trigger) trigger.style.display = 'none';
                } else {
                    grid.insertAdjacentHTML("beforeend", html);
                }
            } catch (error) {
                console.error("Failed to fetch more movies");
            } finally {
                isLoading = false;
                spinner.classList.add("d-none");
            }
        }
    });
</script>