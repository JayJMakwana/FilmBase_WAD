@model IEnumerable<FilmBase.Models.DTOs.TmdbMovieDto>

@{
    ViewData["Title"] = ViewData["CategoryTitle"];
    var categorySlug = ViewData["CategorySlug"] as string;
}

<div class="py-4">
    <!-- Header bar -->
    <div class="flex items-center justify-between border-b border-white/[0.08] pb-5 mb-8">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="p-2 px-3 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white border border-white/10 transition-colors flex items-center gap-2 text-xs font-semibold text-decoration-none">
                <span>←</span>
                <span>Back</span>
            </a>
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-display">
                    @ViewData["CategoryTitle"]
                </h1>
                <p class="text-xs text-slate-400 mt-0.5">
                    Showing collection titles
                </p>
            </div>
        </div>
    </div>

    <!-- Movie Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6 mb-8" id="movie-grid">
        @if (Model != null && Model.Any())
        {
            <partial name="_MovieCards" model="Model" />
        }
        else
        {
            <div class="col-span-full py-24 text-center" id="no-results-msg">
                <p class="text-slate-400 text-base">No movies found for this collection.</p>
            </div>
        }
    </div>

    <!-- Infinite Scroll Trigger -->
    @if (Model != null && Model.Any())
    {
        <div id="scroll-trigger" class="py-12 flex justify-center">
            <div class="hidden items-center gap-2.5 text-indigo-400 text-sm font-medium" id="loading-spinner">
                <span class="animate-spin text-lg">⏳</span>
                <span>Loading more films...</span>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;

        const category = '@Html.Raw(categorySlug ?? "")';
        const spinner = document.getElementById("loading-spinner");
        const grid = document.getElementById("movie-grid");
        const trigger = document.getElementById("scroll-trigger");

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !isLoading && hasMore) {
                loadMoreMovies();
            }
        }, { rootMargin: "300px" });

        if (trigger) observer.observe(trigger);

        async function loadMoreMovies() {
            isLoading = true;
            if (spinner) spinner.classList.remove("hidden");
            currentPage++;

            const params = new URLSearchParams({ category: category, page: currentPage, ajax: 'true' });

            try {
                const response = await fetch(`/Movies/Browse?${params.toString()}`);
                const html = await response.text();

                if (html.trim().length === 0) {
                    hasMore = false;
                    if (trigger) trigger.style.display = 'none';
                } else {
                    grid.insertAdjacentHTML("beforeend", html);
                }
            } catch (error) {
                console.error("Failed to fetch more movies");
            } finally {
                isLoading = false;
                if (spinner) spinner.classList.add("hidden");
            }
        }
    });
</script>
