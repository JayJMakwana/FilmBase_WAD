@model FilmBase.Models.HomePageViewModel

@{
    ViewData["Title"] = "Home";
    
    var movieRows = new List<(string Title, string Id, IEnumerable<FilmBase.Models.DTOs.TmdbMovieDto> Movies)>
    {
        ("New Releases", "newreleases", Model.NewReleasedMovies),
        ("Trending This Week", "trending", Model.TrendingMovies),
        ("Top Rated of All Time", "toprated", Model.TopRatedMovies),
        ("Animation Favorites", "animation", Model.AnimationMovies),
        ("Popular Hindi Movies", "hindi", Model.HindiMovies),
        ("Gujarati Cinema", "gujarati", Model.GujaratiMovies),
        ("Sci-Fi Adventures", "scifi", Model.SciFiMovies),
        ("Horror & Thrills", "horror", Model.HorrorMovies),
        ("Critically Acclaimed (10k+ Votes)", "oscars", Model.OscarsWinningMovies),
        ("Popular English Movies", "english", Model.EnglishMovies)
    };
}

<!-- Cinematic Hero Banner -->
<div class="relative mb-12 rounded-2xl overflow-hidden shadow-2xl border border-white/10">
    <div class="relative min-h-[380px] sm:min-h-[440px] flex items-end p-6 sm:p-10 lg:p-12 bg-cover bg-center"
         style="background-image: linear-gradient(to top, #07090e 5%, rgba(7,9,14,0.7) 40%, rgba(7,9,14,0.3) 100%), linear-gradient(to right, #07090e 20%, rgba(7,9,14,0.8) 50%, rgba(7,9,14,0.2) 100%), url('/images/cinematic_hero_banner.jpg'), url('https://wsrv.nl/?url=image.tmdb.org/t/p/original/b33nnKl1GSFbao4l3fZDDqsTc0F.jpg');">
        <div class="max-w-2xl z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-medium mb-4 backdrop-blur-md">
                <span>🎬</span>
                <span>Cinema Catalog & Personal Watchlists</span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight font-display mb-3">
                Welcome to FilmBase
            </h1>

            <p class="text-slate-300 text-sm sm:text-base mb-6 leading-relaxed">
                Track, discover, and save your favorite movies in one place. Browse curated collections, search international cinema, and curate your personalized watchlist.
            </p>

            <div class="flex flex-wrap items-center gap-3">
                <a asp-controller="Movies" asp-action="Discover" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-semibold flex items-center gap-2 shadow-lg shadow-indigo-600/30 transition-all hover:scale-102 text-decoration-none">
                    <span>🧭</span>
                    <span>Discover Titles</span>
                </a>

                <a asp-controller="Movies" asp-action="Browse" asp-route-category="trending" class="px-5 py-2.5 rounded-xl bg-white/[0.08] hover:bg-white/[0.15] text-white text-xs sm:text-sm font-semibold flex items-center gap-2 border border-white/10 transition-all text-decoration-none">
                    <span>🔥</span>
                    <span>Trending This Week</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Movie Rows -->
<div class="space-y-12">
    @foreach (var row in movieRows)
    {
        if (row.Movies != null && row.Movies.Any())
        {
            <section class="mb-10">
                <!-- Row Header -->
                <div class="flex items-center justify-between mb-4 px-1">
                    <div class="flex items-baseline gap-3">
                        <h2 class="text-xl font-bold text-white tracking-tight font-display">
                            @row.Title
                        </h2>
                        <span class="text-xs text-slate-500 font-mono">
                            @row.Movies.Count() films
                        </span>
                    </div>

                    <a asp-controller="Movies" asp-action="Browse" asp-route-category="@row.Id" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1 transition-colors text-decoration-none">
                        <span>See All</span>
                        <span>➔</span>
                    </a>
                </div>

                <!-- Horizontal Carousel Container -->
                <div class="flex items-stretch gap-4 overflow-x-auto pb-3 pt-1 px-1 scroll-smooth" style="scrollbar-width: none; -ms-overflow-style: none;">
                    @foreach (var movie in row.Movies)
                    {
                        var rating = movie.VoteAverage.HasValue && movie.VoteAverage > 0 ? movie.VoteAverage.Value.ToString("0.1") : null;
                        var year = !string.IsNullOrEmpty(movie.ReleaseDate) && movie.ReleaseDate.Length >= 4 ? movie.ReleaseDate.Substring(0, 4) : "";

                        <div class="flex-none w-40 sm:w-44 md:w-48">
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="group block text-decoration-none">
                                <div class="relative aspect-[2/3] w-full rounded-xl overflow-hidden bg-[#111522] border border-white/[0.08] shadow-md transition-all duration-300 group-hover:scale-[1.03] group-hover:border-indigo-500/50 group-hover:shadow-2xl group-hover:shadow-indigo-500/10">
                                    @if (rating != null)
                                    {
                                        <div class="absolute top-2.5 right-2.5 flex items-center gap-1 px-2 py-0.5 rounded-md bg-black/75 backdrop-blur-md border border-white/10 text-[11px] font-medium text-amber-300 z-10">
                                            <span>⭐</span>
                                            <span>@rating</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(movie.PosterPath))
                                    {
                                        <img src="https://wsrv.nl/?url=image.tmdb.org/t/p/w500@(movie.PosterPath)" alt="@movie.Title" class="w-full h-full object-cover" loading="lazy" onerror="this.src='/images/movie_poster_fallback.jpg';" />
                                    }
                                    else
                                    {
                                        <img src="/images/movie_poster_fallback.jpg" alt="@movie.Title" class="w-full h-full object-cover" loading="lazy" />
                                    }

                                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity pointer-events-none"></div>

                                    <div class="absolute bottom-0 inset-x-0 p-3 flex flex-col justify-end pointer-events-none">
                                        <h3 class="text-sm font-semibold text-white truncate group-hover:text-indigo-300 transition-colors">
                                            @movie.Title
                                        </h3>
                                        <div class="flex items-center gap-1.5 text-xs text-slate-400 mt-1">
                                            @if (!string.IsNullOrEmpty(year))
                                            {
                                                <span>@year</span>
                                            }
                                            @if (!string.IsNullOrEmpty(year) && rating != null)
                                            {
                                                <span>·</span>
                                            }
                                            @if (rating != null)
                                            {
                                                <span>Score @rating</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    <!-- "Explore More" Card at End of Row -->
                    <div class="flex-none w-40 sm:w-44 md:w-48">
                        <a asp-controller="Movies" asp-action="Browse" asp-route-category="@row.Id" class="group block h-full text-decoration-none">
                            <div class="relative aspect-[2/3] w-full rounded-xl overflow-hidden bg-[#111522]/80 hover:bg-[#151a2b] border border-white/[0.08] hover:border-indigo-500/50 shadow-md transition-all duration-300 group-hover:scale-[1.03] flex flex-col items-center justify-center text-center p-4">
                                <div class="w-12 h-12 rounded-full bg-indigo-600/20 group-hover:bg-indigo-600/30 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-3 transition-colors text-lg">
                                    ➔
                                </div>
                                <span class="text-sm font-bold text-white group-hover:text-indigo-300 transition-colors">
                                    Explore More
                                </span>
                                <span class="text-xs text-slate-400 mt-1">
                                    View all @row.Title
                                </span>
                            </div>
                        </a>
                    </div>
                </div>
            </section>
        }
    }
</div>
