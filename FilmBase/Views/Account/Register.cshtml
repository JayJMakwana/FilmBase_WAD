@{
    ViewData["Title"] = "Sign Up";
}

<div class="max-w-md mx-auto mt-12 p-8 rounded-2xl bg-[#0e121d] border border-white/10 shadow-2xl">
    <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white font-display tracking-wide">Join FilmBase</h1>
        <p class="text-xs text-slate-400 mt-1">Create an account to save lists and connect with friends</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs">
            @ViewBag.Error
        </div>
    }

    <form method="post" asp-action="Register" class="space-y-4">
        <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Username</label>
            <input type="text" name="username" required class="w-full px-4 py-2.5 text-sm bg-black/40 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" placeholder="moviebuff99" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Email</label>
            <input type="email" name="email" required class="w-full px-4 py-2.5 text-sm bg-black/40 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" placeholder="you@example.com" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-300 mb-1.5">Password (min 6 chars)</label>
            <input type="password" name="password" minlength="6" required class="w-full px-4 py-2.5 text-sm bg-black/40 text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500" placeholder="••••••••" />
        </div>
        <button type="submit" class="w-full py-2.5 mt-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-lg shadow-indigo-600/30 transition-all cursor-pointer border-0">
            Create Account
        </button>
    </form>

    <p class="text-center text-xs text-slate-400 mt-6 mb-0">
        Already have an account?
        <a asp-action="Login" class="text-indigo-400 hover:text-indigo-300 font-semibold text-decoration-none">Sign in</a>
    </p>
</div>