@model FilmBase.Models.CloudWatchlist
@{
    var friendUid = ViewData["FriendUid"] as string ?? string.Empty;
    var friendName = ViewData["FriendName"] as string ?? "Friend";
    var count = Model.Items?.Count ?? 0;
    ViewData["Title"] = $"{Model.Name} · {friendName}";
}

<div class="py-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.08] pb-6 mb-10">
        <div>
            <div class="flex items-center gap-4 mb-2">
                <a asp-action="Watchlists" asp-route-friendUid="@friendUid"
                   class="inline-flex items-center gap-1.5 text-xs font-medium text-indigo-400 hover:text-indigo-300 text-decoration-none">
                    <span>←</span>
                    <span>Back to @friendName's Lists</span>
                </a>
                <a asp-action="Index"
                   class="text-xs font-medium text-slate-400 hover:text-slate-200 text-decoration-none">
                    All Friends
                </a>
            </div>

            <div class="flex items-baseline gap-3">
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display m-0">
                    @Model.Name
                </h1>
                <span class="text-xs text-slate-500 font-mono">
                    @count @(count == 1 ? "title" : "titles")
                </span>
            </div>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var item in Model.Items)
            {
                <a asp-controller="Movies" asp-action="Details" asp-route-id="@item.TmdbId" asp-route-mediaType="@item.MediaType"
                   class="group relative rounded-xl overflow-hidden bg-[#111522] border border-white/[0.08] shadow-md transition-all hover:scale-[1.03] hover:border-indigo-500/50 block aspect-[2/3] text-decoration-none">
                    <img src="@(!string.IsNullOrEmpty(item.PosterPath) ? $"https://wsrv.nl/?url=image.tmdb.org/t/p/w500{item.PosterPath}" : "/images/movie_poster_fallback.jpg")"
                         alt="@item.Title"
                         class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                    <div class="absolute bottom-0 inset-x-0 p-2.5">
                        <span class="text-xs font-semibold text-white truncate block">@item.Title</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-xs text-slate-400 text-center py-16">This list is empty.</p>
    }
</div>