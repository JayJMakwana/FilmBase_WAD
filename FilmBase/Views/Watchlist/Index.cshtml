@model IEnumerable<FilmBase.Models.Category>

@{
    ViewData["Title"] = "My Watchlist";
}

<div class="py-4">
    <!-- Header Bar with Create List Form -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.08] pb-6 mb-10">
        <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">
                My Watchlist
            </h1>
            <p class="text-xs text-slate-400 mt-1">
                Organize movies across custom curated collections
            </p>
        </div>

        <form asp-controller="Watchlist" asp-action="CreateCategoryFromDetails" method="post" class="flex gap-2">
            <input type="hidden" name="returnTmdbId" value="0" />
            <input type="text"
                   name="categoryName"
                   placeholder="New list name..."
                   required
                   class="px-3.5 py-2 text-xs bg-[#101422] text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500 placeholder:text-slate-500" />
            <button type="submit"
                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md cursor-pointer whitespace-nowrap">
                <span>+</span>
                <span>New List</span>
            </button>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-12">
            @foreach (var category in Model)
            {
                <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                    <!-- Category Header -->
                    <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 mb-6">
                        <div class="flex items-baseline gap-3">
                            <h2 class="text-xl font-bold text-white tracking-wide font-display">
                                @category.Name
                            </h2>
                            <span class="text-xs text-slate-500 font-mono">
                                @(category.WatchlistItems?.Count ?? 0) movies
                            </span>
                        </div>
                    </div>

                    <!-- Items Grid -->
                    @if (category.WatchlistItems != null && category.WatchlistItems.Any())
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                            @foreach (var item in category.WatchlistItems)
                            {
                                <div class="group relative rounded-xl overflow-hidden bg-[#111522] border border-white/[0.08] shadow-md transition-all hover:scale-[1.03] hover:border-indigo-500/50">
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@item.TmdbId" class="block aspect-[2/3] w-full text-decoration-none">
                                        @if (!string.IsNullOrEmpty(item.PosterPath))
                                        {
                                            <img src="https://wsrv.nl/?url=image.tmdb.org/t/p/w500@(item.PosterPath)" alt="@item.Title" class="w-full h-full object-cover" onerror="this.src='/images/movie_poster_fallback.jpg';" />
                                        }
                                        else
                                        {
                                            <img src="/images/movie_poster_fallback.jpg" alt="@item.Title" class="w-full h-full object-cover" />
                                        }
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                                    </a>

                                    <div class="absolute bottom-0 inset-x-0 p-2.5 flex items-center justify-between gap-1 pointer-events-auto">
                                        <span class="text-xs font-semibold text-white truncate">
                                            @item.Title
                                        </span>
                                        <form asp-controller="Watchlist" asp-action="Toggle" method="post" class="m-0">
                                            <input type="hidden" name="tmdbId" value="@item.TmdbId" />
                                            <input type="hidden" name="title" value="@item.Title" />
                                            <input type="hidden" name="posterPath" value="@item.PosterPath" />
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <button type="submit"
                                                    class="p-1 rounded bg-black/60 hover:bg-rose-500/30 text-slate-400 hover:text-rose-300 transition-colors text-xs border-0"
                                                    title="Remove from list">
                                                🗑️
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="py-8 text-center border border-dashed border-white/[0.08] rounded-xl">
                            <p class="text-xs text-slate-400 m-0">
                                No movies in this list yet. Browse films and click "Save to Watchlist".
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="py-20 text-center max-w-md mx-auto">
            <div class="w-14 h-14 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                🎬
            </div>
            <h3 class="text-lg font-bold text-white mb-2">No lists created yet</h3>
            <p class="text-xs text-slate-400 mb-6">
                Search for movies to add them to your watchlist or create custom collections.
            </p>
            <a asp-controller="Movies" asp-action="Discover" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/30 transition-all text-decoration-none">
                <span>🧭</span>
                <span>Discover Movies</span>
            </a>
        </div>
    }
</div>
