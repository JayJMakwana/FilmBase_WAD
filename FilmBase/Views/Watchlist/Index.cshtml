@model IEnumerable<FilmBase.Models.CloudWatchlist>

@{
    ViewData["Title"] = "My Watchlist";
}

<div class="py-4 max-w-5xl mx-auto">
    <!-- Header Bar with Create List Form -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.08] pb-6 mb-8">
        <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">
                My Watchlist
            </h1>
            <p class="text-xs text-slate-400 mt-1">
                Your custom movie and series collections
            </p>
        </div>

        <form asp-controller="Watchlist" asp-action="CreateCategoryFromDetails" method="post" class="flex gap-2">
            <input type="hidden" name="returnTmdbId" value="0" />
            <input type="text"
                   name="categoryName"
                   placeholder="New list name..."
                   required
                   class="px-3.5 py-2 text-xs bg-[#101422] text-white border border-white/10 rounded-xl focus:outline-none focus:border-indigo-500 placeholder:text-slate-500" />
            <button type="submit"
                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md cursor-pointer whitespace-nowrap border-0">
                <span>+</span>
                <span>New List</span>
            </button>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-4">
            @foreach (var category in Model)
            {
                var count = category.Items?.Count ?? 0;
                var previews = category.Items?.Take(4).ToList() ?? new List<FilmBase.Models.CloudMovie>();

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.08] hover:border-indigo-500/40 transition-all">
                    <a asp-controller="Watchlist" asp-action="Details" asp-route-id="@category.Id" class="flex items-center gap-4 flex-1 min-w-0 text-decoration-none group">
                        <!-- Mini Poster Preview Strip -->
                        <div class="flex -space-x-3 flex-shrink-0">
                            @if (previews.Any())
                            {
                                foreach (var item in previews)
                                {
                                    <div class="w-11 h-16 rounded-lg overflow-hidden border border-white/15 bg-[#111522] shadow-md">
                                        <img src="@(!string.IsNullOrEmpty(item.PosterPath) ? $"https://wsrv.nl/?url=image.tmdb.org/t/p/w185{item.PosterPath}" : "/images/movie_poster_fallback.jpg")"
                                             alt="@item.Title"
                                             class="w-full h-full object-cover" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="w-11 h-16 rounded-lg border border-dashed border-white/15 bg-white/[0.02] flex items-center justify-center text-slate-500 text-sm">
                                    🎬
                                </div>
                            }
                        </div>

                        <!-- List Name & Count -->
                        <div class="min-w-0">
                            <h2 class="text-lg font-bold text-white group-hover:text-indigo-300 transition-colors font-display truncate m-0">
                                @category.Name
                            </h2>
                            <p class="text-xs text-slate-400 font-mono mt-1 mb-0">
                                @count @(count == 1 ? "title" : "titles")
                            </p>
                        </div>
                    </a>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 self-end sm:self-center">
                        <a asp-controller="Watchlist" asp-action="Details" asp-route-id="@category.Id"
                           class="px-3.5 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 text-xs font-semibold text-decoration-none transition-colors">
                            Open List →
                        </a>

                        <form asp-controller="Watchlist" asp-action="DeleteList" method="post" class="m-0">
                            <input type="hidden" name="categoryId" value="@category.Id" />
                            <button type="submit"
                                    class="px-2.5 py-1.5 rounded-lg text-xs text-rose-400 hover:bg-rose-500/10 border border-rose-500/20 cursor-pointer bg-transparent transition-colors">
                                Delete List
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="py-20 text-center max-w-md mx-auto">
            <div class="w-14 h-14 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                🎬
            </div>
            <h3 class="text-lg font-bold text-white mb-2">No lists created yet</h3>
            <p class="text-xs text-slate-400 mb-6">
                Create a list above or browse movies and series to start saving titles.
            </p>
            <a asp-controller="Movies" asp-action="Discover" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/30 transition-all text-decoration-none">
                <span>🧭</span>
                <span>Discover Titles</span>
            </a>
        </div>
    }
</div>